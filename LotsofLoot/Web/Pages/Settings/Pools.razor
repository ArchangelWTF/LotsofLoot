@implements IDisposable;

@page "/lotsofloot/settings/pools"

@layout BaseMudBlazorLayout
@inject ConfigService configService

<PageTitle>Pool settings - Lots of Loot Redux</PageTitle>

<LotsofLootLayout>
    <MudPaper Elevation="0" Class="lotsofloot-hero spt-panel pa-5">
        <MudText Typo="Typo.overline" Class="spt-kicker">Settings</MudText>
        <MudText Typo="Typo.h3" Class="spt-title">Pools &amp; Containers</MudText>
        <MudText Typo="Typo.body2" Class="spt-subtitle mt-2">Bias individual items inside their loose loot pools and change how often static containers spawn loot.</MudText>
    </MudPaper>

    <SettingsFilterBar Placeholder="Filter settings...">
        <MudExpansionPanels MultiExpansion="true">
            <MudExpansionPanel @bind-Expanded="poolsExpanded">
                <TitleContent><PanelTitle Text="Loose loot pools" KeyPrefix="Pools.LooseLoot." /></TitleContent>
                <ChildContent>
                <MudGrid>
                    <ConfigMongoIdDictionary Key="Pools.LooseLoot.ChangeRelativeProbabilityInPool"
                                          Label="Relative probability in pool"
                                          Tooltip="Multiplies an item's relative probability inside the pool it already belongs to, making it more likely to be picked over the other items in that same pool"
                                          @bind-Value="configService.EditablePresetHolder.presetConfig.ChangeRelativeProbabilityInPool"
                                          OriginalValue="configService.LotsofLootPresetConfig.ChangeRelativeProbabilityInPool"
                                          DefaultValue="DefaultRelativeProbabilityInPool" />

                    <ConfigMongoIdDictionary Key="Pools.LooseLoot.ChangeProbabilityOfPool"
                                          Label="Probability of pool"
                                          Tooltip="Multiplies the chance that the spawnpoint pool containing this item is rolled at all"
                                          @bind-Value="configService.EditablePresetHolder.presetConfig.ChangeProbabilityOfPool"
                                          OriginalValue="configService.LotsofLootPresetConfig.ChangeProbabilityOfPool"
                                          DefaultValue="DefaultProbabilityOfPool" />
                </MudGrid>
                </ChildContent>
            </MudExpansionPanel>

            <MudExpansionPanel @bind-Expanded="containersExpanded">
                <TitleContent><PanelTitle Text="Static containers" KeyPrefix="Pools.Containers." /></TitleContent>
                <ChildContent>
                <MudGrid>
                    <ConfigMongoIdDictionary Key="Pools.Containers.FillChance"
                                          Label="Container fill chance"
                                          Tooltip="Relative chance multiplier that no items spawn in this container. 0 means items every time, 1 leaves the container untouched"
                                          @bind-Value="configService.EditablePresetHolder.presetConfig.Containers"
                                          OriginalValue="configService.LotsofLootPresetConfig.Containers"
                                          DefaultValue="DefaultContainers" />
                </MudGrid>
                </ChildContent>
            </MudExpansionPanel>
            </MudExpansionPanels>
    </SettingsFilterBar>
</LotsofLootLayout>

@code {
    private bool poolsExpanded = true;
    private bool containersExpanded = true;

    private static readonly Dictionary<MongoId, double> DefaultRelativeProbabilityInPool = new()
    {
        // Graphics card
        { "57347ca924597744596b4e71", 2 }
